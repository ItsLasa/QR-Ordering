# cPanel MySQL Database Connection
# Format: mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>
#
# Examples:
# - If app is running on the cPanel server:
#   DATABASE_URL="mysql://cpaneluser_dbuser:StrongPassword123!@localhost:3306/cpaneluser_dbname"
# - If connecting remotely (from Vercel, Netlify, or local machine):
#   DATABASE_URL="mysql://cpaneluser_dbuser:StrongPassword123!@yourdomain.com:3306/cpaneluser_dbname"
#   (Make sure your IP or '%' is added under cPanel -> "Remote MySQL")
DATABASE_URL="mysql://cpaneluser_dbuser:password@localhost:3306/cpaneluser_dbname"

# Authentication & Application Settings
JWT_SECRET="qr-ordering-super-secret-key-32-chars-long-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
